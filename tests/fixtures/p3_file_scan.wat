(core func $scan (canon lower (func $consumer "run")))
(core module $scan-file
  (import "host" "memory" (memory 1 1))
  (import "host" "reset" (func $reset))
  (import "host" "directories" (func $directories (param i32)))
  (import "host" "open" (func $open (param i32 i32 i32 i32 i32 i32 i32)))
  (import "host" "read" (func $read (param i32 i64 i32)))
  (import "host" "scan" (func $scan (param i32) (result f64)))
  (import "host" "drop-descriptor" (func $drop-descriptor (param i32)))
  (import "host" "await" (func $await (param i32 i32) (result i32)))
  (import "host" "drop-future" (func $drop-future (param i32)))
  (func (export "run") (param $directory-input i32) (result i32)
    (local $directory i32) (local $source i32) (local $completion i32) (local $sum f64)
    (call $reset)
    (call $directories (i32.const 0))
    (if (i32.ne (i32.load (i32.const 4)) (i32.const 1)) (then unreachable))
    (local.set $directory (i32.load (i32.load (i32.const 0))))
    (if (local.get $directory-input)
      (then (local.set $source (local.get $directory)))
      (else
        (call $open (local.get $directory) (i32.const 0) (i32.const 512) (i32.const 9) (i32.const 0) (i32.const 1) (i32.const 64))
        (if (i32.load8_u (i32.const 64)) (then unreachable))
        (local.set $source (i32.load (i32.const 68)))))
    (call $read (local.get $source) (i64.const 0) (i32.const 128))
    (local.set $completion (i32.load (i32.const 132)))
    (local.set $sum (call $scan (i32.load (i32.const 128))))
    (if (call $await (local.get $completion) (i32.const 192)) (then unreachable))
    (call $drop-future (local.get $completion))
    (if (i32.ne (local.get $source) (local.get $directory)) (then (call $drop-descriptor (local.get $source))))
    (call $drop-descriptor (local.get $directory))
    (f64.store (i32.const 320) (local.get $sum))
    (i32.store (i32.const 328) (i32.load8_u (i32.const 192)))
    (i32.store (i32.const 332) (if (result i32) (i32.load8_u (i32.const 192))
      (then (i32.load8_u (i32.const 196))) (else (i32.const 0))))
    (i32.const 320)))
(core instance $scan-file (instantiate $scan-file (with "host" (instance
  (export "memory" (memory $storage "memory")) (export "reset" (func $storage "reset"))
  (export "directories" (func $directories)) (export "open" (func $open))
  (export "read" (func $read)) (export "scan" (func $scan))
  (export "drop-descriptor" (func $drop-descriptor))
  (export "await" (func $await)) (export "drop-future" (func $drop-future))))))
(func (export "run") async (param "directory-input" bool) (result (tuple f64 u32 u32))
  (canon lift (core func $scan-file "run") (memory (core memory $storage "memory"))))
