(module
  (import "$root" "[async-lower]wait" (func $start (param i32 i32) (result i32)))
  (import "$root" "[async-lower][subtask-cancel]" (func $cancel (param i32) (result i32)))
  (import "$root" "[subtask-drop]" (func $drop (param i32)))
  (import "$root" "[waitable-set-new]" (func $new-set (result i32)))
  (import "$root" "[waitable-set-drop]" (func $drop-set (param i32)))
  (import "$root" "[waitable-join]" (func $join (param i32 i32)))
  (import "[export]$root" "[task-return]run" (func $return (param i32)))
  (import "[export]$root" "[task-cancel]" (func $acknowledge))
  (memory (export "memory") 1)
  (global $task (mut i32) (i32.const 0))
  (global $set (mut i32) (i32.const 0))
  (global $cancelled (mut i32) (i32.const 0))
  (global $immediate (mut i32) (i32.const 0))
  (func $finish (param $status i32) (result i32)
    (call $join (global.get $task) (i32.const 0))
    (call $drop (global.get $task))
    (call $drop-set (global.get $set))
    (if (global.get $cancelled)
      (then (call $acknowledge))
      (else
        (if (i32.ne (local.get $status) (i32.const 2)) (then unreachable))
        (call $return (i32.load (i32.const 32)))))
    (i32.const 0))
  (func $waiting (result i32)
    (i32.or (i32.shl (global.get $set) (i32.const 4)) (i32.const 2)))
  (func (export "[async-lift]run") (param $mode i32) (result i32)
    (local $status i32)
    (global.set $cancelled (i32.const 0))
    (global.set $immediate (i32.const 0))
    (local.set $status (call $start (local.get $mode) (i32.const 32)))
    ;; Wasmtime 49 retains an immediately returned callback subtask. Delivering
    ;; the result on the next turn gives its caller a handle to release.
    (if (i32.eq (i32.and (local.get $status) (i32.const 15)) (i32.const 2))
      (then (global.set $immediate (i32.const 1)) (return (i32.const 1))))
    (global.set $task (i32.shr_u (local.get $status) (i32.const 4)))
    (global.set $set (call $new-set))
    (call $join (global.get $task) (global.get $set))
    (call $waiting))
  (func (export "[callback][async-lift]run") (param $event i32) (param $handle i32) (param $status i32) (result i32)
    (if (global.get $immediate)
      (then
        (if (i32.eq (local.get $event) (i32.const 6))
          (then (call $acknowledge))
          (else (call $return (i32.load (i32.const 32)))))
        (return (i32.const 0))))
    (if (i32.eq (local.get $event) (i32.const 6))
      (then
        (global.set $cancelled (i32.const 1))
        (call $join (global.get $task) (i32.const 0))
        (local.set $status (call $cancel (global.get $task)))
        (if (i32.ne (local.get $status) (i32.const -1))
          (then (return (call $finish (local.get $status)))))
        (call $join (global.get $task) (global.get $set))
        (return (call $waiting))))
    (if (i32.ne (local.get $event) (i32.const 1)) (then unreachable))
    (if (i32.ne (local.get $handle) (global.get $task)) (then unreachable))
    (if (i32.ge_u (local.get $status) (i32.const 2))
      (then (return (call $finish (local.get $status)))))
    (call $waiting)))
