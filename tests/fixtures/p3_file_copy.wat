(component
  (import "wasi:filesystem/types@0.3.0" (instance $filesystem
    (export "descriptor" (type $descriptor (sub resource)))
    (type $borrow (borrow $descriptor))
    (type $own (own $descriptor))
    (type $error-base (variant
      (case "access") (case "already") (case "bad-descriptor") (case "busy")
      (case "deadlock") (case "quota") (case "exist") (case "file-too-large")
      (case "illegal-byte-sequence") (case "in-progress") (case "interrupted")
      (case "invalid") (case "io") (case "is-directory") (case "loop")
      (case "too-many-links") (case "message-size") (case "name-too-long")
      (case "no-device") (case "no-entry") (case "no-lock")
      (case "insufficient-memory") (case "insufficient-space") (case "not-directory")
      (case "not-empty") (case "not-recoverable") (case "unsupported") (case "no-tty")
      (case "no-such-device") (case "overflow") (case "not-permitted") (case "pipe")
      (case "read-only") (case "invalid-seek") (case "text-file-busy")
      (case "cross-device") (case "other" (option string))))
    (export "error-code" (type $error (eq $error-base)))
    (type $bytes (stream u8))
    (type $completion (future (result (error $error))))
    (type $path-flags-base (flags "symlink-follow"))
    (export "path-flags" (type $path-flags (eq $path-flags-base)))
    (type $open-flags-base (flags "create" "directory" "exclusive" "truncate"))
    (export "open-flags" (type $open-flags (eq $open-flags-base)))
    (type $descriptor-flags-base (flags "read" "write" "file-integrity-sync" "data-integrity-sync" "requested-write-sync" "mutate-directory"))
    (export "descriptor-flags" (type $descriptor-flags (eq $descriptor-flags-base)))
    (export "[method]descriptor.open-at" (func async
      (param "self" $borrow) (param "path-flags" $path-flags) (param "path" string)
      (param "open-flags" $open-flags) (param "flags" $descriptor-flags)
      (result (result $own (error $error)))))
    (export "[method]descriptor.read-via-stream" (func
      (param "self" $borrow) (param "offset" u64) (result (tuple $bytes $completion))))
    (export "[method]descriptor.write-via-stream" (func
      (param "self" $borrow) (param "data" $bytes) (param "offset" u64) (result $completion)))))
  (alias export $filesystem "descriptor" (type $descriptor))
  (alias export $filesystem "error-code" (type $error))
  (import "wasi:filesystem/preopens@0.3.0" (instance $preopens
    (alias outer 1 $descriptor (type $outer-descriptor))
    (export "descriptor" (type $descriptor (eq $outer-descriptor)))
    (export "get-directories" (func (result (list (tuple (own $descriptor) string)))))))
  (type $completion (future (result (error $error))))
  (core module $storage
    (memory (export "memory") 1 1)
    (global $bump (mut i32) (i32.const 1024))
    (data (i32.const 512) "input.bin")
    (data (i32.const 528) "output.bin")
    (func (export "reset") (global.set $bump (i32.const 1024)))
    (func (export "realloc") (param i32 i32) (param $align i32) (param $size i32) (result i32)
      (local $pointer i32)
      (local.set $pointer (i32.and (i32.add (global.get $bump) (i32.sub (local.get $align) (i32.const 1))) (i32.sub (i32.const 0) (local.get $align))))
      (global.set $bump (i32.add (local.get $pointer) (local.get $size)))
      (if (i32.gt_u (global.get $bump) (i32.const 65536)) (then unreachable))
      (local.get $pointer))
    (func (export "pages") (result i32) memory.size))
  (core instance $storage (instantiate $storage))
  (core func $directories (canon lower (func $preopens "get-directories")
    (memory (core memory $storage "memory")) (realloc (core func $storage "realloc"))))
  (core func $open (canon lower (func $filesystem "[method]descriptor.open-at")
    (memory (core memory $storage "memory")) (realloc (core func $storage "realloc"))))
  (core func $read (canon lower (func $filesystem "[method]descriptor.read-via-stream")
    (memory (core memory $storage "memory"))))
  (core func $write (canon lower (func $filesystem "[method]descriptor.write-via-stream")))
  (core func $drop-descriptor (canon resource.drop $descriptor))
  (core func $await (canon future.read $completion
    (memory (core memory $storage "memory")) (realloc (core func $storage "realloc"))))
  (core func $drop-future (canon future.drop-readable $completion))
  (core module $copy
    (import "host" "memory" (memory 1 1))
    (import "host" "reset" (func $reset))
    (import "host" "directories" (func $directories (param i32)))
    (import "host" "open" (func $open (param i32 i32 i32 i32 i32 i32 i32)))
    (import "host" "read" (func $read (param i32 i64 i32)))
    (import "host" "write" (func $write (param i32 i32 i64) (result i32)))
    (import "host" "drop-descriptor" (func $drop-descriptor (param i32)))
    (import "host" "await" (func $await (param i32 i32) (result i32)))
    (import "host" "drop-future" (func $drop-future (param i32)))
    (func (export "run") (param $mode i32) (result i32)
      (local $directory i32) (local $source i32) (local $target i32)
      (local $read-result i32) (local $write-result i32)
      (call $reset)
      (call $directories (i32.const 0))
      (if (i32.ne (i32.load (i32.const 4)) (i32.const 1)) (then unreachable))
      (local.set $directory (i32.load (i32.load (i32.const 0))))
      (if (i32.eq (local.get $mode) (i32.const 1))
        (then (local.set $source (local.get $directory)))
        (else
          (call $open (local.get $directory) (i32.const 0) (i32.const 512) (i32.const 9) (i32.const 0) (i32.const 1) (i32.const 64))
          (if (i32.load8_u (i32.const 64)) (then unreachable))
          (local.set $source (i32.load (i32.const 68)))))
      (if (i32.eq (local.get $mode) (i32.const 2))
        (then (local.set $target (local.get $directory)))
        (else
          (call $open (local.get $directory) (i32.const 0) (i32.const 528) (i32.const 10) (i32.const 9) (i32.const 2) (i32.const 64))
          (if (i32.load8_u (i32.const 64)) (then unreachable))
          (local.set $target (i32.load (i32.const 68)))))
      (call $read (local.get $source) (i64.const 0) (i32.const 128))
      (local.set $read-result (i32.load (i32.const 132)))
      (local.set $write-result (call $write (local.get $target) (i32.load (i32.const 128)) (i64.const 0)))
      ;; Future completion has code 0; its singleton payload has no packed count.
      (if (call $await (local.get $read-result) (i32.const 192)) (then unreachable))
      (call $drop-future (local.get $read-result))
      (if (call $await (local.get $write-result) (i32.const 224)) (then unreachable))
      (call $drop-future (local.get $write-result))
      (if (i32.ne (local.get $source) (local.get $directory)) (then (call $drop-descriptor (local.get $source))))
      (if (i32.ne (local.get $target) (local.get $directory)) (then (call $drop-descriptor (local.get $target))))
      (call $drop-descriptor (local.get $directory))
      (i32.store (i32.const 320) (i32.load8_u (i32.const 192)))
      (i32.store (i32.const 324) (if (result i32) (i32.load8_u (i32.const 192))
        (then (i32.load8_u (i32.const 196))) (else (i32.const 0))))
      (i32.store (i32.const 328) (i32.load8_u (i32.const 224)))
      (i32.store (i32.const 332) (if (result i32) (i32.load8_u (i32.const 224))
        (then (i32.load8_u (i32.const 228))) (else (i32.const 0))))
      (i32.const 320)))
  (core instance $copy (instantiate $copy (with "host" (instance
    (export "memory" (memory $storage "memory")) (export "reset" (func $storage "reset"))
    (export "directories" (func $directories)) (export "open" (func $open))
    (export "read" (func $read)) (export "write" (func $write))
    (export "drop-descriptor" (func $drop-descriptor))
    (export "await" (func $await)) (export "drop-future" (func $drop-future))))))
  (func (export "run") async (param "mode" u32) (result (tuple u32 u32 u32 u32))
    (canon lift (core func $copy "run") (memory (core memory $storage "memory"))))
  (func (export "memory-pages") (result u32) (canon lift (core func $storage "pages"))))
