{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "typeRoots": [
      "./.perry/types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "src/**/*",
    ".perry/types/**/*"
  ]
}
