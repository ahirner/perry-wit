{
  "name": "perry-wit-js",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace=perry-wit",
    "build:site": "npm run build --workspace=perry-wit-site",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "node scripts/e2e.mjs",
    "test:browser": "node site/check-browser.mjs"
  }
}
