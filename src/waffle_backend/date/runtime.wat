(module
  (import "host" "realloc" (func $realloc (param i32 i32 i32 i32) (result i32)))
  (memory 1)
  (func (export "date.new") (param $time f64) (result i32)
    (local $date i32)
    (local.set $date (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 8)))
    (if (f64.le (f64.abs (local.get $time)) (f64.const 8640000000000000))
      (then (local.set $time (f64.add (f64.trunc (local.get $time)) (f64.const 0))))
      (else (local.set $time (f64.const nan))))
    (f64.store (local.get $date) (local.get $time))
    (local.get $date))

  ;; Gregorian civil date from days since 1970-01-01, using 400-year eras.
  (func $calendar (param $days i32) (result i32 i32 i32)
    (local $era i32) (local $day-of-era i32) (local $year-of-era i32)
    (local $year i32) (local $day-of-year i32) (local $month i32) (local $day i32)
    (local.set $days (i32.add (local.get $days) (i32.const 719468)))
    (local.set $era (i32.div_s
      (select (local.get $days) (i32.sub (local.get $days) (i32.const 146096)) (i32.ge_s (local.get $days) (i32.const 0)))
      (i32.const 146097)))
    (local.set $day-of-era (i32.sub (local.get $days) (i32.mul (local.get $era) (i32.const 146097))))
    (local.set $year-of-era (i32.div_u
      (i32.sub (i32.add (i32.sub (local.get $day-of-era) (i32.div_u (local.get $day-of-era) (i32.const 1460)))
        (i32.div_u (local.get $day-of-era) (i32.const 36524)))
        (i32.div_u (local.get $day-of-era) (i32.const 146096))) (i32.const 365)))
    (local.set $year (i32.add (local.get $year-of-era) (i32.mul (local.get $era) (i32.const 400))))
    (local.set $day-of-year (i32.sub (local.get $day-of-era)
      (i32.sub (i32.add (i32.mul (local.get $year-of-era) (i32.const 365)) (i32.div_u (local.get $year-of-era) (i32.const 4)))
        (i32.div_u (local.get $year-of-era) (i32.const 100)))))
    (local.set $month (i32.div_u (i32.add (i32.mul (local.get $day-of-year) (i32.const 5)) (i32.const 2)) (i32.const 153)))
    (local.set $day (i32.add (i32.sub (local.get $day-of-year)
      (i32.div_u (i32.add (i32.mul (local.get $month) (i32.const 153)) (i32.const 2)) (i32.const 5))) (i32.const 1)))
    (local.set $month (i32.add (local.get $month) (select (i32.const 3) (i32.const -9) (i32.lt_u (local.get $month) (i32.const 10)))))
    (i32.add (local.get $year) (i32.le_u (local.get $month) (i32.const 2)))
    (local.get $month) (local.get $day))

  (func $decimal (param $output i32) (param $number i32) (param $digits i32)
    (loop $digit
      (local.set $digits (i32.sub (local.get $digits) (i32.const 1)))
      (i32.store8 (i32.add (local.get $output) (local.get $digits)) (i32.add (i32.rem_u (local.get $number) (i32.const 10)) (i32.const 48)))
      (local.set $number (i32.div_u (local.get $number) (i32.const 10)))
      (br_if $digit (local.get $digits))))

  (func (export "date.iso") (param $date i32) (result i32 f64)
    (local $time f64) (local $year i32) (local $length i32) (local $string i32) (local $output i32)
    (local $days i32) (local $remainder i32) (local $month i32) (local $day i32)
    (local.set $time (f64.load (local.get $date)))
    (if (f64.ne (local.get $time) (local.get $time)) (then (return (i32.const 1) (f64.const 1))))
    (local.set $days (i32.trunc_f64_s (f64.floor (f64.div (local.get $time) (f64.const 86400000)))))
    (call $calendar (local.get $days))
    (local.set $day) (local.set $month) (local.set $year)
    (local.set $remainder (i32.trunc_f64_u (f64.sub (local.get $time) (f64.mul (f64.convert_i32_s (local.get $days)) (f64.const 86400000)))))
    (local.set $length (select (i32.const 24) (i32.const 27) (i32.le_u (local.get $year) (i32.const 9999))))
    (local.set $string (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.add (local.get $length) (i32.const 12))))
    (i32.store offset=16 (i32.load (i32.sub (local.get $string) (i32.const 4))) (i32.const 1))
    (local.set $output (i32.add (local.get $string) (i32.const 12)))
    (i32.store (local.get $string) (local.get $output))
    (i32.store offset=4 (local.get $string) (local.get $length))
    (i32.store offset=8 (local.get $string) (local.get $length))
    (if (i32.eq (local.get $length) (i32.const 24))
      (then (call $decimal (local.get $output) (local.get $year) (i32.const 4))
        (local.set $output (i32.add (local.get $output) (i32.const 4))))
      (else
        (i32.store8 (local.get $output) (select (i32.const 45) (i32.const 43) (i32.lt_s (local.get $year) (i32.const 0))))
        (call $decimal (i32.add (local.get $output) (i32.const 1))
          (select (i32.sub (i32.const 0) (local.get $year)) (local.get $year) (i32.lt_s (local.get $year) (i32.const 0))) (i32.const 6))
        (local.set $output (i32.add (local.get $output) (i32.const 7)))))
    (i32.store8 (local.get $output) (i32.const 45))
    (call $decimal (i32.add (local.get $output) (i32.const 1)) (local.get $month) (i32.const 2))
    (i32.store8 offset=3 (local.get $output) (i32.const 45))
    (call $decimal (i32.add (local.get $output) (i32.const 4)) (local.get $day) (i32.const 2))
    (i32.store8 offset=6 (local.get $output) (i32.const 84))
    (call $decimal (i32.add (local.get $output) (i32.const 7)) (i32.div_u (local.get $remainder) (i32.const 3600000)) (i32.const 2))
    (i32.store8 offset=9 (local.get $output) (i32.const 58))
    (call $decimal (i32.add (local.get $output) (i32.const 10)) (i32.rem_u (i32.div_u (local.get $remainder) (i32.const 60000)) (i32.const 60)) (i32.const 2))
    (i32.store8 offset=12 (local.get $output) (i32.const 58))
    (call $decimal (i32.add (local.get $output) (i32.const 13)) (i32.rem_u (i32.div_u (local.get $remainder) (i32.const 1000)) (i32.const 60)) (i32.const 2))
    (i32.store8 offset=15 (local.get $output) (i32.const 46))
    (call $decimal (i32.add (local.get $output) (i32.const 16)) (i32.rem_u (local.get $remainder) (i32.const 1000)) (i32.const 3))
    (i32.store8 offset=19 (local.get $output) (i32.const 90))
    (i32.const 0) (f64.convert_i32_u (local.get $string)))
)
