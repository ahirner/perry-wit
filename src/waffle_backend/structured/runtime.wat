  (func (export "stats.lift") (param $size f64) (param $mtime f64) (param $kind i32) (result i32)
    (local $stats i32)
    (if (i32.gt_u (local.get $kind) (i32.const 7)) (then unreachable))
    (local.set $stats (call $realloc (i32.const 0) (i32.const 0) (i32.const 8) (i32.const 24)))
    (f64.store (local.get $stats) (local.get $size))
    (f64.store offset=8 (local.get $stats) (local.get $mtime))
    (i32.store offset=16 (local.get $stats) (local.get $kind))
    (local.get $stats))
  (func $strings-lift (export "strings.lift") (param $data i32) (param $count i32) (result i32)
    (local $array i32) (local $index i32) (local $source i32) (local $target i32)
    (local $scalars i32) (local $invalid i32)
    (if (i32.gt_u (local.get $count) (i32.const 357913940)) (then unreachable))
    (local.set $array (call $realloc (i32.const 0) (i32.const 0) (i32.const 4) (i32.add (i32.const 8) (i32.mul (local.get $count) (i32.const 12)))))
    (i32.store offset=16 (i32.load (i32.sub (local.get $array) (i32.const 4))) (i32.const 2))
    (i32.store (local.get $array) (i32.add (local.get $array) (i32.const 8)))
    (i32.store offset=4 (local.get $array) (local.get $count))
    (block $done (loop $entries
      (br_if $done (i32.eq (local.get $index) (local.get $count)))
      (local.set $source (i32.add (local.get $data) (i32.mul (local.get $index) (i32.const 8))))
      (local.set $target (i32.add (i32.add (local.get $array) (i32.const 8)) (i32.mul (local.get $index) (i32.const 12))))
      (call $scan (i32.load (local.get $source)) (i32.load offset=4 (local.get $source)) (i32.const 0))
      local.set $invalid local.set $scalars drop
      (if (i32.ne (local.get $invalid) (i32.const -1)) (then unreachable))
      (i32.store (local.get $target) (i32.load (local.get $source)))
      (i32.store offset=4 (local.get $target) (i32.load offset=4 (local.get $source)))
      (i32.store offset=8 (local.get $target) (local.get $scalars))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $entries)))
    (local.get $array))
  ;; Consume owned canonical strings into one backing allocation for retained snapshots.
  (func (export "strings.take") (param $data i32) (param $count i32) (result i32)
    (local $array i32) (local $index i32) (local $source i32) (local $target i32)
    (local $size i64) (local $backing i32) (local $length i32) (local $pointer i32)
    (local.set $array (call $strings-lift (local.get $data) (local.get $count)))
    (block $measured (loop $measure
      (br_if $measured (i32.eq (local.get $index) (local.get $count)))
      (local.set $size (i64.add (local.get $size) (i64.extend_i32_u
        (i32.load offset=4 (i32.add (local.get $data) (i32.mul (local.get $index) (i32.const 8)))))))
      (if (i64.gt_u (local.get $size) (i64.const 4294967295)) (then unreachable))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $measure)))
    (local.set $backing (call $realloc (i32.const 0) (i32.const 0) (i32.const 1) (i32.wrap_i64 (local.get $size))))
    (local.set $index (i32.const 0))
    (block $copied (loop $copy
      (br_if $copied (i32.eq (local.get $index) (local.get $count)))
      (local.set $source (i32.add (local.get $data) (i32.mul (local.get $index) (i32.const 8))))
      (local.set $pointer (i32.load (local.get $source)))
      (local.set $length (i32.load offset=4 (local.get $source)))
      (memory.copy (local.get $backing) (local.get $pointer) (local.get $length))
      (local.set $target (i32.add (i32.load (local.get $array)) (i32.mul (local.get $index) (i32.const 12))))
      (i32.store (local.get $target) (local.get $backing))
      (drop (call $realloc (local.get $pointer) (local.get $length) (i32.const 1) (i32.const 0)))
      (local.set $backing (i32.add (local.get $backing) (local.get $length)))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $copy)))
    (drop (call $realloc (local.get $data) (i32.mul (local.get $count) (i32.const 8)) (i32.const 4) (i32.const 0)))
    (local.get $array))

  (func (export "strings.lower") (param $array i32) (result i32)
    (local $data i32) (local $count i32) (local $result i32) (local $index i32)
    (local $source i32) (local $target i32)
    (local.set $data (i32.load (local.get $array)))
    (local.set $count (i32.load offset=4 (local.get $array)))
    (if (i32.gt_u (local.get $count) (i32.const 536870910)) (then unreachable))
