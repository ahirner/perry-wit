    (i32.store (local.get $result) (i32.add (local.get $result) (i32.const 8)))
    (i32.store offset=4 (local.get $result) (local.get $count))
    (block $done (loop $entries
      (br_if $done (i32.eq (local.get $index) (local.get $count)))
      (local.set $source (i32.add (local.get $data) (i32.mul (local.get $index) (i32.const 12))))
      (local.set $target (i32.add (i32.add (local.get $result) (i32.const 8)) (i32.mul (local.get $index) (i32.const 8))))
      (i32.store (local.get $target) (i32.load (local.get $source)))
      (i32.store offset=4 (local.get $target) (i32.load offset=4 (local.get $source)))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $entries)))
    (local.get $result))
