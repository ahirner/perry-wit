;; Native writing shares descriptor layouts and slot loading with decoding.
;; Data contains literal text, variant keys, retention policy, and a date-format buffer.
  (import "__perry_helper" "std_json_raw" (func $write-raw (param i32 i32 i32)))
  (import "__perry_helper" "std_json_number" (func $write-number (param i32 f64)))
  (import "__perry_helper" "std_json_write_numeric" (func $write-numeric (param i32 i32 i64)))
  (import "__perry_helper" "std_json_quote" (func $write-quote (param i32 i32)))
  (import "__perry_helper" "std_json_value" (func $write-graph (param i32 i32)))
  (import "__perry_helper" "std_json_open" (func $write-open (param i32 i32) (result i32)))
  (import "__perry_helper" "std_json_close" (func $write-close (param i32 i32)))
  (import "__perry_helper" "std_json_key" (func $write-key (param i32 i32)))
  (import "__perry_helper" "std_json_item" (func $write-item (param i32)))
  (import "__perry_helper" "std_json_members" (func $write-members (param i32) (result i32)))
  (import "__perry_helper" "std_json_record_index" (func $write-index (param i32 i32 i32) (result i32)))
  (import "__perry_helper" "std_json_write_member" (func $write-member (param i32 i32)))
  (import "__perry_helper" "std_json_extras" (func $write-extras (param i32 i32 i32 i32)))

  (import "__perry_helper" "time_date_iso" (func $write-date (param f64 i32 i32) (result i64)))
  (import "__perry_helper" "std_json_writer" (func $writer (result i32)))
  (import "__perry_helper" "std_json_finish" (func $write-finish (param i32) (result i32)))

  (func (export "json_descriptor_stringify") (param $schema i32) (param $bits i64) (param $tag i32) (param $data i32) (result i32)
    (local $writer i32)
    (if (i32.eq (call $native-absence (local.get $schema) (local.get $bits) (local.get $tag)) (i32.const 1))
      (then (return (i32.const 0))))
    (local.set $writer (call $writer))
    (call $write (local.get $writer) (local.get $schema) (local.get $bits) (local.get $tag) (local.get $data) (i32.const 0))
    (call $write-finish (local.get $writer)))

  ;; Each carrier has consecutive undefined, null, and omitted encodings.
  (func $absence-base (param $kind i32) (result i64)
    (if (i32.or (i32.eq (local.get $kind) (i32.const @descriptor.NUMBER@)) (i32.eq (local.get $kind) (i32.const @descriptor.JSON_NUMERIC@)))
      (then (return (i64.const @descriptor.UNDEFINED_BITS@))))
    (select (i64.const @descriptor.UNDEFINED_BOOL@) (i64.const 0) (i32.eq (local.get $kind) (i32.const @descriptor.BOOLEAN@))))

  (func $absent-bits (param $schema i32) (param $tag i32) (result i64)
    (i64.add (call $absence-base (i32.load (i32.and (local.get $schema) (i32.const @descriptor.SCHEMA_MASK@))))
      (i64.extend_i32_u (i32.sub (local.get $tag) (i32.const @numeric.UNDEFINED@)))))

  ;; Schema references carry allowed absence in their low two bits; base descriptors stay aligned.
  ;; 0 = present, 1 = undefined/omitted, 2 = null. Disallowed sentinels remain ordinary values.
  (func $native-absence (param $schema i32) (param $bits i64) (param $tag i32) (result i32)
    (local $flags i32) (local $kind i32) (local $offset i64)
    (local.set $flags (i32.and (local.get $schema) (i32.const @descriptor.ABSENCE_MASK@)))
    (local.set $kind (i32.load (i32.and (local.get $schema) (i32.const @descriptor.SCHEMA_MASK@))))
    (if (i32.eq (local.get $kind) (i32.const @descriptor.JSON_VALUE@))
      (then (return (i64.eqz (local.get $bits)))))
    (if (i32.eqz (local.get $flags)) (then (return (i32.const 0))))
    (local.set $offset (if (result i64) (i32.eq (local.get $kind) (i32.const @descriptor.JSON_NUMERIC@))
      (then (i64.extend_i32_u (i32.sub (local.get $tag) (i32.const @numeric.UNDEFINED@))))
      (else (i64.sub (local.get $bits) (call $absence-base (local.get $kind))))))
    (if (i64.gt_u (local.get $offset) (i64.const 2)) (then (return (i32.const 0))))
    (i32.and (local.get $flags)
      (select (i32.const @descriptor.NULL_ALLOWED@) (i32.const @descriptor.UNDEFINED_ALLOWED@) (i64.eq (local.get $offset) (i64.const 1)))))

  (func $write-field (param $writer i32) (param $schema i32) (param $object i32) (param $index i32) (param $data i32)
    (local $entry i32) (local $child i32) (local $bits i64) (local $tag i32) (local $prefix i32)
    (local.set $entry (i32.add (local.get $schema) (i32.add (i32.const @descriptor.FIELDS@) (i32.mul (local.get $index) (i32.const @descriptor.FIELD_SIZE@)))))
    (local.set $child (i32.load offset=@descriptor.FIELD_SCHEMA@ (local.get $entry)))
    (call $load (local.get $child) (i32.add (local.get $object) (i32.load offset=@descriptor.FIELD_OFFSET@ (local.get $entry))))
    (local.set $tag) (local.set $bits)
    (local.set $prefix (i32.load offset=20 (i32.add (call $metadata (local.get $schema)) (i32.mul (local.get $index) (i32.const 8)))))
    (call $write (local.get $writer) (local.get $child) (local.get $bits) (local.get $tag) (local.get $data) (local.get $prefix)))

  (func $write-record (param $writer i32) (param $schema i32) (param $object i32) (param $data i32)
    (local $metadata i32) (local $count i32) (local $graph i32) (local $member i32)
    (local $order i32) (local $position i32) (local $index i32)
    (local.set $metadata (call $metadata (local.get $schema)))
    (local.set $count (i32.load offset=4 (local.get $schema)))
    (if (i32.load offset=@descriptor.WRITE_RETAINS_JSON@ (local.get $data))
      (then (local.set $graph (i32.load offset=@record.JSON@ (local.get $object)))))
    (if (local.get $graph)
      (then
        (local.set $member (call $write-members (local.get $graph)))
        (block $done (loop $members
          (br_if $done (i32.eqz (local.get $member)))
          (local.set $index (call $write-index (local.get $member) (i32.load offset=8 (local.get $metadata)) (local.get $count)))
          (if (i32.lt_u (local.get $index) (local.get $count))
            (then (call $write-field (local.get $writer) (local.get $schema) (local.get $object) (local.get $index) (local.get $data)))
            (else (call $write-member (local.get $writer) (local.get $member))))
          (local.set $member (i32.load offset=@json.NEXT@ (local.get $member)))
          (br $members)))
        (return)))
    ;; Numeric names precede insertion-ordered names. The static chain uses one-based indices.
    (local.set $index (i32.load offset=16 (local.get $metadata)))
    (block $numeric-done (loop $numeric
      (br_if $numeric-done (i32.eqz (local.get $index)))
      (local.set $index (i32.sub (local.get $index) (i32.const 1)))
      (call $write-field (local.get $writer) (local.get $schema) (local.get $object) (local.get $index) (local.get $data))
      (local.set $index (i32.load offset=24 (i32.add (local.get $metadata) (i32.mul (local.get $index) (i32.const 8)))))
      (br $numeric)))
    (local.set $order (i32.load offset=@record.ORDER@ (local.get $object)))
    (block $ordered-done (loop $ordered
      (if (i32.le_u (local.get $count) (i32.const @record.PACKED_FIELDS@))
        (then
          (br_if $ordered-done (i32.eqz (local.get $order)))
          (local.set $index (i32.sub (i32.and (local.get $order) (i32.const 15)) (i32.const 1)))
          (local.set $order (i32.shr_u (local.get $order) (i32.const 4))))
        (else
          (br_if $ordered-done (i32.eqz (local.get $order)))
          (br_if $ordered-done (i32.ge_u (local.get $position) (i32.load (local.get $order))))
          (local.set $index (i32.load offset=4 (i32.add (local.get $order) (i32.mul (local.get $position) (i32.const 4)))))
          (local.set $position (i32.add (local.get $position) (i32.const 1)))))
      (if (i32.eq (i32.load offset=24 (i32.add (local.get $metadata) (i32.mul (local.get $index) (i32.const 8)))) (i32.const -1))
        (then (call $write-field (local.get $writer) (local.get $schema) (local.get $object) (local.get $index) (local.get $data))))
      (br $ordered))))

  (func $write-variant (param $writer i32) (param $schema i32) (param $object i32) (param $data i32)
    (local $tag i32) (local $index i32) (local $entry i32) (local $child i32)
    (local $bits i64) (local $payload-tag i32) (local $count i32)
    (local.set $tag (i32.load offset=@variant.TAG@ (local.get $object)))
    (call $write-key (local.get $writer) (i32.load offset=@descriptor.WRITE_TAG_KEY@ (local.get $data)))
    (call $write-quote (local.get $writer) (local.get $tag))
    (local.set $count (i32.const 1))
    (block $done (loop $cases
      (br_if $done (i32.ge_u (local.get $index) (i32.load offset=4 (local.get $schema))))
      (local.set $entry (i32.add (local.get $schema) (i32.add (i32.const @descriptor.FIELDS@) (i32.mul (local.get $index) (i32.const @descriptor.FIELD_SIZE@)))))
      (if (i32.eqz (call $string-compare (local.get $tag) (i32.load (local.get $entry))))
        (then
          (local.set $child (i32.load offset=@descriptor.FIELD_SCHEMA@ (local.get $entry)))
          (br_if $done (i32.eqz (local.get $child)))
          (local.set $count (i32.const 2))
          (call $load (local.get $child) (i32.add (local.get $object) (i32.const @variant.VALUE@)))
          (local.set $payload-tag) (local.set $bits)
          (call $write (local.get $writer) (local.get $child) (local.get $bits) (local.get $payload-tag) (local.get $data)
            (i32.load offset=@descriptor.WRITE_VALUE_KEY@ (local.get $data)))
          (br $done)))
      (local.set $index (i32.add (local.get $index) (i32.const 1)))
      (br $cases)))
    (if (i32.load offset=@descriptor.WRITE_RETAINS_JSON@ (local.get $data))
      (then (call $write-extras (local.get $writer) (i32.load offset=@variant.JSON@ (local.get $object))
        (i32.add (local.get $data) (i32.const @descriptor.WRITE_TAG_NAME@)) (local.get $count)))))

  ;; Prefix: 0 = bare value, 1 = array item, even address = quoted key, odd address = dynamic key.
  ;; String headers are aligned; the low bit distinguishes dictionary names without allocating prefixes.
  (func $write (param $writer i32) (param $schema i32) (param $bits i64) (param $tag i32) (param $data i32) (param $prefix i32)
    (local $absent i32)
    (local $kind i32) (local $object i32) (local $count i32) (local $index i32)
    (local $child i32) (local $element i32) (local $elements i32) (local $entry i32) (local $slot i32) (local $payload i64) (local $payload-tag i32)
    (local $formatted i64)
    (local $array i32) (local $dictionary i32) (local $tuple i32) (local $buffer i32)
    (if (i32.and (local.get $schema) (i32.const @descriptor.ABSENCE_MASK@))
      (then (local.set $absent (call $native-absence (local.get $schema) (local.get $bits) (local.get $tag)))))
    (local.set $schema (i32.and (local.get $schema) (i32.const @descriptor.SCHEMA_MASK@)))
    (local.set $kind (i32.load (local.get $schema)))
    (if (i32.gt_u (local.get $prefix) (i32.const 1))
      (then
        (if (i32.or (i32.eq (local.get $absent) (i32.const 1))
                    (i32.and (i32.eq (local.get $kind) (i32.const @descriptor.JSON_VALUE@)) (i64.eqz (local.get $bits))))
          (then (return)))
        (if (i32.and (local.get $prefix) (i32.const 1))
          (then
            (call $write-item (local.get $writer))
            (call $write-quote (local.get $writer) (i32.and (local.get $prefix) (i32.const -2)))
            (call $write-raw (local.get $writer) (i32.add (local.get $data) (i32.const @descriptor.WRITE_COLON@)) (i32.const 1)))
          (else (call $write-key (local.get $writer) (local.get $prefix)))))
      (else
        (if (local.get $prefix) (then (call $write-item (local.get $writer))))))
    (if (local.get $absent)
      (then (call $write-raw (local.get $writer) (local.get $data) (i32.const 4)) (return)))
    (if (i32.eq (local.get $kind) (i32.const @descriptor.NUMBER@))
      (then
        (call $write-number (local.get $writer) (f64.reinterpret_i64 (local.get $bits)))
        (return)))
    (if (i32.eq (local.get $kind) (i32.const @descriptor.JSON_NUMERIC@))
      (then
        (call $write-numeric (local.get $writer) (local.get $tag) (local.get $bits))
        (return)))
    (if (i32.or (i32.eq (local.get $kind) (i32.const @descriptor.SIGNED_INT@)) (i32.eq (local.get $kind) (i32.const @descriptor.UNSIGNED_INT@)))
      (then
        (call $write-numeric (local.get $writer)
          (select (i32.const @numeric.SIGNED@) (i32.const @numeric.UNSIGNED@) (i32.eq (local.get $kind) (i32.const @descriptor.SIGNED_INT@))) (local.get $bits))
        (return)))
    (local.set $object (i32.wrap_i64 (local.get $bits)))
    (if (i32.eq (local.get $kind) (i32.const @descriptor.BOOLEAN@))
      (then
        (call $write-raw (local.get $writer)
          (i32.add (local.get $data) (select (i32.const @descriptor.WRITE_TRUE@) (i32.const @descriptor.WRITE_FALSE@) (local.get $object)))
          (select (i32.const 4) (i32.const 5) (local.get $object)))
        (return)))
    (if (i32.eq (local.get $kind) (i32.const @descriptor.STRING@))
      (then
        (call $write-quote (local.get $writer) (local.get $object))
        (return)))
    (if (i32.eq (local.get $kind) (i32.const @descriptor.JSON_VALUE@))
      (then
        (call $write-graph (local.get $writer) (local.get $object))
        (return)))
    (if (i32.eq (local.get $kind) (i32.const @descriptor.EXCEPTION@))
      (then
        (call $write-raw (local.get $writer) (i32.add (local.get $data) (i32.const @descriptor.WRITE_EMPTY_OBJECT@)) (i32.const 2))
        (return)))
    (if (i32.eq (local.get $kind) (i32.const @descriptor.JSON_VALUE_UNION@))
      (then
        (block $union-done (loop $union-cases
          (br_if $union-done (i32.ge_u (local.get $index) (i32.load offset=4 (local.get $schema))))
          (local.set $entry (i32.add (local.get $schema) (i32.add (i32.const 8) (i32.mul (local.get $index) (i32.const 12)))))
          (if (i32.eq (i32.load offset=@variant.TAG@ (local.get $object)) (i32.load (local.get $entry)))
            (then
              (local.set $child (i32.load offset=4 (local.get $entry)))
              (call $load (local.get $child) (i32.add (local.get $object) (i32.const @variant.VALUE@)))
              local.set $payload-tag local.set $payload
              (call $write (local.get $writer) (local.get $child) (local.get $payload) (local.get $payload-tag) (local.get $data) (i32.const 0))
              (return)))
          (local.set $index (i32.add (local.get $index) (i32.const 1)))
          (br $union-cases)))
        (return)))
    (if (i32.eq (local.get $kind) (i32.const @descriptor.JSON_NUMBER_STRING@))
      (then
        (if (i32.eq (i32.load offset=@variant.TAG@ (local.get $object)) (i32.load offset=8 (local.get $schema)))
          (then (call $write-number (local.get $writer) (f64.load offset=@variant.VALUE@ (local.get $object))))
          (else (call $write-quote (local.get $writer) (i32.load offset=@variant.VALUE@ (local.get $object)))))
        (return)))
    (if (i32.eq (local.get $kind) (i32.const @descriptor.JSON_DATE@))
      (then
        ;; The formatter has no callbacks or safepoints; this buffer is consumed before recursion resumes.
        (local.set $buffer (i32.add (local.get $data) (i32.const @descriptor.WRITE_DATE_BUFFER@)))
        (local.set $formatted (call $write-date (f64.load (local.get $object)) (local.get $buffer) (i32.const @descriptor.WRITE_DATE_CAPACITY@)))
        (if (i64.eqz (i64.shr_u (local.get $formatted) (i64.const 32)))
          (then
            (call $write-raw (local.get $writer) (i32.add (local.get $data) (i32.const @descriptor.WRITE_QUOTE@)) (i32.const 1))
            (call $write-raw (local.get $writer) (local.get $buffer) (i32.wrap_i64 (local.get $formatted)))
            (call $write-raw (local.get $writer) (i32.add (local.get $data) (i32.const @descriptor.WRITE_QUOTE@)) (i32.const 1)))
          (else (call $write-raw (local.get $writer) (local.get $data) (i32.const 4))))
        (return)))
    (if (i32.eq (local.get $kind) (i32.const @descriptor.JSON_VARIANT@))
      (then
        (if (call $write-open (local.get $writer) (i32.const 123))
          (then
            (call $write-variant (local.get $writer) (local.get $schema) (local.get $object) (local.get $data))
            (call $write-close (local.get $writer) (i32.const 125))))
        (return)))
    (local.set $tuple (i32.eq (local.get $kind) (i32.const @descriptor.JSON_TUPLE@)))
    (local.set $array (i32.or (local.get $tuple) (i32.eq (local.get $kind) (i32.const @descriptor.ARRAY@))))
    (if (i32.eqz (call $write-open (local.get $writer) (select (i32.const 91) (i32.const 123) (local.get $array))))
      (then (return)))
    (if (i32.eq (local.get $kind) (i32.const @descriptor.RECORD@))
      (then (call $write-record (local.get $writer) (local.get $schema) (local.get $object) (local.get $data)))
      (else
        (local.set $dictionary (i32.eq (local.get $kind) (i32.const @descriptor.JSON_DICTIONARY@)))
        (if (local.get $tuple)
          (then (local.set $count (i32.load offset=4 (local.get $schema))))
          (else
            (local.set $count (i32.load offset=@array.LEN@ (local.get $object)))
            (local.set $buffer (i32.load offset=@array.DATA@ (local.get $object)))
            (local.set $element (i32.load offset=4 (local.get $schema)))
            (local.set $elements (i32.load offset=8 (local.get $schema)))))
        (block $done (loop $items
          (br_if $done (i32.ge_u (local.get $index) (local.get $count)))
          (if (local.get $tuple)
            (then
              (local.set $entry (i32.add (local.get $schema) (i32.add (i32.const @descriptor.FIELDS@) (i32.mul (local.get $index) (i32.const @descriptor.FIELD_SIZE@)))))
              (local.set $child (i32.load offset=@descriptor.FIELD_SCHEMA@ (local.get $entry)))
              (local.set $slot (i32.add (local.get $object) (i32.load offset=@descriptor.FIELD_OFFSET@ (local.get $entry)))))
            (else
              (local.set $child (local.get $element))
              (local.set $slot (call $slot (local.get $buffer) (local.get $index) (local.get $elements)))))
          (if (local.get $dictionary)
            (then
              (local.set $entry (i32.load (local.get $slot)))
              (local.set $slot (i32.add (local.get $entry) (i32.load offset=@descriptor.DICTIONARY_VALUE_OFFSET@ (local.get $child))))
              (local.set $child (i32.load offset=@descriptor.DICTIONARY_VALUE_SCHEMA@ (local.get $child)))))
          (call $load (local.get $child) (local.get $slot))
          (local.set $payload-tag) (local.set $payload)
          (local.set $prefix (i32.const 1))
          (if (local.get $dictionary)
            (then (local.set $prefix (i32.or (i32.load offset=@record.HEADER@ (local.get $entry)) (i32.const 1)))))
          (call $write (local.get $writer) (local.get $child) (local.get $payload) (local.get $payload-tag) (local.get $data) (local.get $prefix))
          (local.set $index (i32.add (local.get $index) (i32.const 1)))
          (br $items)))
        (if (i32.and (local.get $tuple) (i32.load offset=@descriptor.WRITE_RETAINS_JSON@ (local.get $data)))
          (then (call $write-extras (local.get $writer) (i32.load offset=@record.JSON@ (local.get $object)) (i32.const 0) (local.get $count))))))
    (call $write-close (local.get $writer) (select (i32.const 93) (i32.const 125) (local.get $array))))
