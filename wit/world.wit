package perry:demo@0.1.0;

world runtime-adapter {
  import wasi:cli/stdout@0.2.6;
  import wasi:cli/stderr@0.2.6;
  import wasi:cli/exit@0.2.6;
  import wasi:clocks/wall-clock@0.2.6;
  import wasi:clocks/monotonic-clock@0.2.6;
  import wasi:http/outgoing-handler@0.2.6;
  import wasi:http/types@0.2.6;
  import wasi:io/poll@0.2.6;
  import wasi:io/streams@0.2.6;
  import wasi:random/random@0.2.6;
  import wasi:random/insecure@0.2.6;
}

world merge-docs {
  include wasi:cli/command@0.2.6;
  import wasi:http/outgoing-handler@0.2.6;
  import wasi:http/types@0.2.6;
}

world task-runner {
  include runtime-adapter;
  export run-task: func(input: string) -> string;
}

world merge-task {
  include runtime-adapter;

  record merge-input {
    title: string,
    content: string,
    author: string,
  }

  record merged-doc {
    id: string,
    header: string,
    body: string,
  }

  export run-task: func(input: string) -> string;
  export merge-task: func(input: string) -> string;
}
