package perry:compiler@0.2.0;

interface api {
  /// Optional diagnostic name; for an entrypoint, also its logical module identity.
  /// Anonymous single-source compilation needs no name. Names never access host files.
  record source {
    name: option<string>,
    contents: list<u8>,
  }
  /// Dependency modules require package-relative logical identifiers for import resolution.
  record module {
    name: string,
    contents: list<u8>,
  }
  record program {
    source: source,
    modules: list<module>,
  }
  variant wit-package {
    sources(list<source>),
    encoded(list<u8>),
  }
  record wit-input {
    application: wit-package,
    dependencies: list<wit-package>,
  }
  record compile-options {
    %world: option<string>,
    /// Omit component wrapping, retaining the selected WIT world's canonical ABI.
    core-only: bool,
  }
  record component-output {
    bytes: list<u8>,
    stripped: list<u8>,
  }
  record compiled {
    core: list<u8>,
    component: option<component-output>,
    allocation-report: string,
  }
  record artifact {
    name: string,
    contents: list<u8>,
  }
  enum diagnostic-code {
    parse-error,
    unsupported-operator,
    unsupported-spread,
    missing-type-annotation,
    unsupported-type,
    unsupported-expression,
    incompatible-record-layout,
    missing-required-field,
    absence-mismatch,
    interface-mismatch,
    export-mismatch,
    import-signature-mismatch,
    module-resolution,
    invalid-input,
    wit-resolution,
    codegen-failure,
    missing-error-channel,
    io,
    internal-compiler-error,
  }
  enum diagnostic-severity { error, warning, info }
  record source-span {
    file: string,
    start-line: u32,
    start-column: u32,
    end-line: u32,
    end-column: u32,
    start-byte: u64,
    end-byte: u64,
  }
  record diagnostic {
    code: diagnostic-code,
    severity: diagnostic-severity,
    message: string,
    span: option<source-span>,
    notes: list<string>,
    help: option<string>,
  }
  compile: func(program: program, wit: wit-input, options: compile-options) -> result<compiled, list<diagnostic>>;
  /// Raw TypeScript exports without WIT. This differs from compile with core-only,
  /// which still checks a WIT world and emits its canonical ABI.
  compile-core: func(program: program) -> result<list<u8>, list<diagnostic>>;
  generate-wit: func(program: program, %world: option<string>) -> result<list<artifact>, list<diagnostic>>;
  generate-sdk: func(wit: option<wit-input>, %world: option<string>) -> result<list<artifact>, list<diagnostic>>;
}

world compiler {
  export api;
}
